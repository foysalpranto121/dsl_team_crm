# Backend settings for local development. Copy to .env and fill in.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. Online (Neon) use one line instead of the DB_ values:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_NAME=DSLCRM
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# Where the React app runs (for CORS, cookies and links in emails)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Google Sign-In: Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
# Optional: only allow these Google Workspace domains, comma separated (empty = any Google account)
GOOGLE_ALLOWED_DOMAINS=

# People approved as admin automatically on their first Google sign-in, comma separated
ADMIN_EMAILS=

# Weekly management digest: a long random value. A weekly cron-job.org job POSTs /api/ops/digest/run/ with the header
# X-Cron-Secret set to it. Empty = no automatic sending (admins can still send it from Admin -> Weekly digest).
DIGEST_CRON_SECRET=
# Extra people who get the digest besides admins and management accounts, comma separated.
DIGEST_EXTRA_RECIPIENTS=

# Online on free Render, email goes through Brevo's API instead of Gmail (Render blocks SMTP). See DEPLOY.md.
# BREVO_API_KEY=

# Gmail for approval emails (Google Account -> Security -> App passwords). Empty = emails print in the terminal.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=DSL Business Team Operation System (TOS) <no-reply@localhost>
